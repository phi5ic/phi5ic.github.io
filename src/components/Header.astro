---
const navItems = [
  { label: 'writing', href: '/posts/' },
  { label: 'about', href: '/about/' },
  { label: 'github', href: 'https://github.com/phi5ic', external: true },
];
---

<header class="border-b border-[#292e42] py-4 mb-12">
  <div class="max-w-2xl mx-auto flex items-baseline justify-between px-4 sm:px-0">
    <a href="/" class="inline-flex items-center gap-2 font-bold text-white tracking-tight text-base no-underline hover:text-[#7dcfff] group">
      <svg class="w-4 h-4 text-[#7aa2f7] group-hover:text-[#7dcfff] transition-colors shrink-0" viewBox="0 0 32 32" fill="none">
        <circle cx="16" cy="16" r="6.5" stroke="currentColor" stroke-width="2.5"/>
        <line x1="16" y1="4" x2="16" y2="28" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
      </svg>
      <span>phi5ic</span>
    </a>

    <nav class="flex items-center gap-5 text-sm">
      {navItems.map((item) => (
        <a
          href={item.href}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}
          class="text-[#7aa2f7] hover:text-[#7dcfff] no-underline"
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
