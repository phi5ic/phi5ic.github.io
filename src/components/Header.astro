---
const navItems = [
  { label: 'writing', href: '/posts/' },
  { label: 'about', href: '/about/' },
  { label: 'github', href: 'https://github.com/phi5ic', external: true },
];
---

<header class="border-b border-[#292e42] py-4 mb-12">
  <div class="max-w-2xl mx-auto flex items-center justify-between px-4 sm:px-0">
    <a href="/" class="inline-flex items-center gap-2.5 font-bold text-white tracking-tight text-base no-underline hover:text-[#39c5bb] transition-colors group">
      <img src="/favicon.svg" alt="Hatsune Miku" class="w-5 h-5 shrink-0" />
      <span>phi5ic</span>
    </a>

    <nav class="flex items-center gap-5 text-sm">
      {navItems.map((item) => (
        <a
          href={item.href}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}
          class="text-[#7aa2f7] hover:text-[#39c5bb] no-underline"
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
