---
interface Props {
  title?: string;
  class?: string;
}

const { title = 'terminal — nifsi', class: className = '' } = Astro.props;
---

<div class={`rounded-xl overflow-hidden border border-white/10 shadow-2xl bg-[#16161e] my-8 transition-all hover:border-white/20 ${className}`}>
  <!-- macOS Titlebar -->
  <div class="flex items-center justify-between px-4 py-2.5 bg-[#1a1b26]/90 border-b border-white/5 select-none">
    <div class="flex items-center gap-2">
      <span class="w-3 h-3 rounded-full bg-[#f7768e] inline-block shadow-sm"></span>
      <span class="w-3 h-3 rounded-full bg-[#e0af68] inline-block shadow-sm"></span>
      <span class="w-3 h-3 rounded-full bg-[#9ece6a] inline-block shadow-sm"></span>
    </div>
    <div class="text-xs font-mono text-[#565f89] truncate max-w-[240px] sm:max-w-md">
      {title}
    </div>
    <div class="w-12"></div> <!-- spacer for balance -->
  </div>

  <!-- Content / Slot -->
  <div class="p-0 leading-none">
    <slot />
  </div>
</div>
