---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import WelcomeOverlay from '../components/WelcomeOverlay.astro';
import GlobalAudioPlayer from '../components/GlobalAudioPlayer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Aravind Anilraj (phi5ic)',
  description = 'Systems engineer and Linux contributor building Nifsi. Writing on storage, erasure coding, and OS internals.',
  image = '/assets/images/posts/nifsi-cluster-status.jpg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- Preload Departure Mono (cyberspace terminal pixel font) -->
    <link rel="preload" href="/fonts/DepartureMono-Regular.woff2" as="font" type="font/woff2" crossorigin="anonymous" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />

    <!-- Instant sub-50ms View Transitions -->
    <ClientRouter />

    <!-- GoatCounter Analytics -->
    <script is:inline>
      window.goatcounter = { no_onload: true };
    </script>
    <script
      data-goatcounter="https://phi5ic.goatcounter.com/count"
      async
      src="//gc.zgo.at/count.js"
    ></script>
    <script is:inline>
      document.addEventListener('astro:page-load', () => {
        const send = () => {
          if (window.goatcounter && typeof window.goatcounter.count === 'function') {
            window.goatcounter.count({
              path: window.location.pathname + window.location.search + window.location.hash,
            });
          }
        };

        if (window.goatcounter && typeof window.goatcounter.count === 'function') {
          send();
        } else {
          const script = document.querySelector('script[data-goatcounter]');
          if (script) {
            script.addEventListener('load', send, { once: true });
          }
        }
      });
    </script>

    <!-- Global BBS/Terminal Keyboard Shortcuts -->
    <script is:inline>
      (() => {
        if (window._terminalShortcutsActive) return;
        window._terminalShortcutsActive = true;

        window.addEventListener('keydown', (e) => {
          // Ignore if user is inside an input, textarea, or editable element
          const target = e.target;
          const tagName = target && target.tagName ? target.tagName.toUpperCase() : '';
          if (tagName === 'INPUT' || tagName === 'TEXTAREA' || (target && target.isContentEditable)) {
            return;
          }
          // Ignore if modifier keys are pressed
          if (e.ctrlKey || e.altKey || e.metaKey) {
            return;
          }

          // If welcome overlay is active, let it handle keypress
          const overlay = document.getElementById('welcome-overlay');
          if (overlay && !overlay.classList.contains('pointer-events-none') && overlay.style.display !== 'none') {
            return;
          }

          const key = e.key.toLowerCase();
          let targetUrl = null;
          let openBlank = false;

          if (e.key === 'Escape' || key === '0' || key === 'h') {
            targetUrl = '/';
          } else if (key === '1') {
            targetUrl = '/about/';
          } else if (key === '2') {
            targetUrl = '/posts/';
          } else if (key === '3') {
            targetUrl = '/projects/';
          } else if (key === '4') {
            targetUrl = '/patches/';
          } else if (key === 'g') {
            targetUrl = 'https://github.com/phi5ic';
            openBlank = true;
          } else if (key === 'm') {
            window.location.href = 'mailto:aravindanilraj0702@gmail.com';
            return;
          }

          if (targetUrl) {
            e.preventDefault();
            if (openBlank) {
              window.open(targetUrl, '_blank', 'noopener,noreferrer');
            } else {
              // Trigger client router navigation via clicking matching anchor tag
              const link = document.querySelector(`a[href="${targetUrl}"]`);
              if (link) {
                link.click();
              } else {
                window.location.href = targetUrl;
              }
            }
          }
        });
      })();
    </script>
  </head>
  <body class="min-h-screen text-[#ecd2e8] bg-[#070308] selection:bg-[#ff2a85] selection:text-[#070308]">
    <WelcomeOverlay />
    <div class="min-h-screen flex">
      <Sidebar />
      <div class="flex-1 flex flex-col min-w-0">
        <Header />
        <main class="flex-grow max-w-4xl w-full mx-auto px-4 sm:px-6">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
    <GlobalAudioPlayer />
  </body>
</html>
