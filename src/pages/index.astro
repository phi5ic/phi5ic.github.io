---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout>
  <div class="space-y-12">
    <!-- Bio Intro -->
    <section>
      <h1 class="text-2xl font-bold text-white tracking-tight mb-1">
        Aravind Anilraj
      </h1>
      <p class="text-xs text-[#7aa2f7] mb-5">
        phi5ic &bull; systems engineer &bull; linux contributor
      </p>

      <p class="text-base text-[#c0caf5] leading-relaxed">
        I contribute Linux kernel patches (<a href="/patches/">ASoC, Thermal</a>) and build <a href="https://github.com/phi5ic/Nifsi" target="_blank" rel="noopener noreferrer">Nifsi</a>, an open-source distributed userspace operating system layer in Rust. I write down what I learn about storage architecture, erasure coding, consensus, and OS internals while building things.
      </p>
    </section>

    <!-- Recent Writing -->
    <section>
      <div class="flex items-center justify-between border-b border-[#292e42] pb-2 mb-4">
        <h2 class="text-xs uppercase tracking-wider text-[#565f89] font-medium">writing</h2>
        <a href="/posts/" class="text-xs text-[#7aa2f7] hover:text-[#7dcfff] no-underline">all posts &rarr;</a>
      </div>

      <div class="space-y-6">
        {posts.map((post) => {
          const postSlug = post.id.replace(/\.mdx?$/, '');
          const formattedDate = new Intl.DateTimeFormat('en-US', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
          }).format(post.data.date);

          return (
            <article class="space-y-1">
              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                <a
                  href={`/posts/${postSlug}/`}
                  class="text-base font-semibold text-white hover:text-[#7dcfff] no-underline"
                >
                  {post.data.title}
                </a>
                <time datetime={post.data.date.toISOString()} class="text-xs text-[#565f89] shrink-0">
                  {formattedDate}
                </time>
              </div>
              <p class="text-sm text-[#9aa5ce] leading-relaxed">
                {post.data.excerpt}
              </p>
            </article>
          );
        })}
      </div>
    </section>

    <!-- Projects -->
    <section>
      <div class="flex items-center justify-between border-b border-[#292e42] pb-2 mb-4">
        <h2 class="text-xs uppercase tracking-wider text-[#565f89] font-medium">projects</h2>
        <a href="/projects/" class="text-xs text-[#7aa2f7] hover:text-[#7dcfff] no-underline">all projects &rarr;</a>
      </div>

      <ul class="space-y-4 text-sm">
        <li>
          <div>
            <a href="https://github.com/phi5ic/Nifsi" target="_blank" rel="noopener noreferrer" class="font-bold text-white hover:text-[#7dcfff] no-underline">
              Nifsi
            </a>
            <span class="text-[#7aa2f7] text-xs ml-1">(Rust)</span>
            <a href="https://github.com/phi5ic/Nifsi" target="_blank" rel="noopener noreferrer" class="text-xs text-[#565f89] hover:text-[#7dcfff] ml-2 font-mono">
              [github &nearr;]
            </a>
          </div>
          <p class="text-[#a9b1d6] mt-0.5 leading-relaxed">
            Distributed userspace OS layer on Linux. Features slice-level homology repair and HADR storage engine.
          </p>
        </li>
        <li>
          <div>
            <a href="/patches/" class="font-bold text-white hover:text-[#7dcfff] no-underline">
              Linux Kernel Patches
            </a>
            <span class="text-[#f7768e] text-xs ml-1">(6 merged)</span>
            <a href="/patches/" class="text-xs text-[#565f89] hover:text-[#7dcfff] ml-2 font-mono">
              [patches &rarr;]
            </a>
          </div>
          <p class="text-[#a9b1d6] mt-0.5 leading-relaxed">
            Upstream contributions to ASoC / Intel sound and Thermal / int340x subsystems. Reviewed by Mark Brown and Rafael J. Wysocki.
          </p>
        </li>
        <li>
          <div>
            <a href="https://github.com/phi5ic/StabiSense" target="_blank" rel="noopener noreferrer" class="font-bold text-white hover:text-[#7dcfff] no-underline">
              StabiSense
            </a>
            <span class="text-[#bb9af7] text-xs ml-1">(IEEE Thailand 2026)</span>
            <a href="https://github.com/phi5ic/StabiSense" target="_blank" rel="noopener noreferrer" class="text-xs text-[#565f89] hover:text-[#7dcfff] ml-2 font-mono">
              [github &nearr;]
            </a>
          </div>
          <p class="text-[#a9b1d6] mt-0.5 leading-relaxed">
            Dynamic stabilization for chipsets during high-precision manufacturing. Finalist at Myosa 5.0.
          </p>
        </li>
        <li>
          <div>
            <a href="https://github.com/phi5ic/Qgis-Simulation" target="_blank" rel="noopener noreferrer" class="font-bold text-white hover:text-[#7dcfff] no-underline">
              Qgis-Simulation
            </a>
            <span class="text-[#9ece6a] text-xs ml-1">(1st Place Hackathon)</span>
            <a href="https://github.com/phi5ic/Qgis-Simulation" target="_blank" rel="noopener noreferrer" class="text-xs text-[#565f89] hover:text-[#7dcfff] ml-2 font-mono">
              [github &nearr;]
            </a>
          </div>
          <p class="text-[#a9b1d6] mt-0.5 leading-relaxed">
            Water pipeline breach detection using ML, Dijkstra pathfinding, and Copernicus SAR satellite radar imagery.
          </p>
        </li>
      </ul>
    </section>

    <!-- Connect -->
    <section>
      <div class="border-b border-[#292e42] pb-2 mb-4">
        <h2 class="text-xs uppercase tracking-wider text-[#565f89] font-medium">connect</h2>
      </div>

      <p class="text-sm text-[#9aa5ce] leading-relaxed mb-3">
        Feel free to inspect my code, discuss distributed storage, or get in touch:
      </p>
      <div class="flex items-center gap-4 text-sm">
        <a href="https://github.com/phi5ic" target="_blank" rel="noopener noreferrer" class="hover:text-[#7dcfff]">github</a>
        <span class="text-[#292e42]">&bull;</span>
        <a href="https://www.linkedin.com/in/aravind-anilraj/" target="_blank" rel="noopener noreferrer" class="hover:text-[#7aa2f7]">linkedin</a>
        <span class="text-[#292e42]">&bull;</span>
        <a href="mailto:aravindanilraj0702@gmail.com" class="hover:text-[#bb9af7]">email</a>
      </div>
    </section>
  </div>
</BaseLayout>
