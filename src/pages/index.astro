---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout>
  <div class="space-y-10 font-mono">
    <!-- Terminal Header / Bio -->
    <section class="space-y-3 border border-[#2a0e2e] bg-[#100613] p-4 sm:p-5 rounded-sm relative overflow-hidden">
      <div class="text-[11px] text-[#854d80]">
        phi5ic@mesh ~ $ finger aravind
      </div>
      <div>
        <h1 class="text-lg sm:text-xl font-bold text-white tracking-tight flex items-center gap-2">
          <span>Aravind Anilraj</span>
          <span class="text-[#ff2a85] text-xs font-normal">[phi5ic]</span>
        </h1>
        <p class="text-xs text-[#ff79c6] mt-0.5">
          systems engineer &bull; linux kernel contributor &bull; storage researcher
        </p>
      </div>

      <p class="text-xs sm:text-sm text-[#ecd2e8] leading-relaxed pt-1">
        I like putting myself into the trenches without any prerequisites and see what breaks, I personally spend my time looking into kernel drivers and working on <a href="https://github.com/phi5ic/Nifsi" target="_blank" rel="noopener noreferrer" class="text-[#ff2a85] hover:text-[#ff79c6]">nifsi</a> and listening to music :)
      </p>

      <div class="pt-2 text-[11px] text-[#854d80] flex flex-wrap gap-x-4 gap-y-1 border-t border-[#2a0e2e]">
        <span>status: working</span>
        <span>&bull;</span>
        <span>stack: rust / c / linux / arm</span>
        <span>&bull;</span>
        <span>host: arch linux</span>
      </div>
    </section>

    <!-- Writing / Postmortems -->
    <section class="space-y-4">
      <div class="flex items-center justify-between border-b border-[#2a0e2e] pb-1.5">
        <h2 class="text-xs uppercase tracking-wider text-[#ff2a85] font-bold">
          -- [01] WRITING &amp; POSTMORTEMS --
        </h2>
        <a href="/posts/" class="text-xs text-[#ff79c6] hover:underline no-underline">[all posts &rarr;]</a>
      </div>

      <div class="space-y-6">
        {posts.map((post) => {
          const postSlug = post.id.replace(/\.mdx?$/, '');
          const formattedDate = new Intl.DateTimeFormat('en-US', {
            year: 'numeric',
            month: '2-digit',
            day: '2-digit',
          }).format(post.data.date);

          return (
            <article class="space-y-1.5 group">
              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                <a
                  href={`/posts/${postSlug}/`}
                  class="text-sm sm:text-base font-bold text-white group-hover:text-[#ff79c6] no-underline"
                >
                  &gt; {post.data.title}
                </a>
                <time datetime={post.data.date.toISOString()} class="text-xs text-[#854d80] shrink-0 font-mono">
                  [{formattedDate}]
                </time>
              </div>
              <p class="text-xs sm:text-sm text-[#c9a6c5] leading-relaxed">
                {post.data.excerpt}
              </p>
              <div class="text-[11px] text-[#854d80] flex flex-wrap items-center gap-2">
                <span class="text-[#ff2a85] border border-[#2a0e2e] bg-[#100613] px-1 py-0.2 rounded-xs text-[10px]">
                  [{post.data.section || 'systems'}]
                </span>
                <span>topic: {post.data.categories ? post.data.categories.join('/') : 'systems'}</span>
                <span>&bull;</span>
                <a href={`/posts/${postSlug}/`} class="text-[#ff2a85] hover:text-[#ff79c6]">read post &rarr;</a>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- Projects -->
    <section class="space-y-4">
      <div class="flex items-center justify-between border-b border-[#2a0e2e] pb-1.5">
        <h2 class="text-xs uppercase tracking-wider text-[#ff2a85] font-bold">
          -- [02] ACTIVE PROJECTS --
        </h2>
        <a href="/projects/" class="text-xs text-[#ff79c6] hover:underline no-underline">[all projects &rarr;]</a>
      </div>

      <ul class="space-y-4 text-xs sm:text-sm">
        <li class="border border-[#2a0e2e] bg-[#100613]/60 p-3 rounded-sm space-y-1">
          <div class="flex flex-wrap items-baseline justify-between gap-1">
            <div>
              <a href="https://github.com/phi5ic/Nifsi" target="_blank" rel="noopener noreferrer" class="font-bold text-white hover:text-[#ff79c6] no-underline">
                * Nifsi
              </a>
              <span class="text-[#ff2a85] text-xs ml-1">[Rust]</span>
            </div>
            <a href="https://github.com/phi5ic/Nifsi" target="_blank" rel="noopener noreferrer" class="text-xs text-[#ff79c6] hover:underline font-mono">
              [github.com/phi5ic/Nifsi &nearr;]
            </a>
          </div>
          <p class="text-[#c9a6c5] leading-relaxed text-xs sm:text-sm">
            Distributed userspace OS layer on Linux. Features sub-packet slice repair (HADR-v2), 3.0&times; bounded write amplification, and Raft state replication.
          </p>
        </li>

        <li class="border border-[#2a0e2e] bg-[#100613]/60 p-3 rounded-sm space-y-1">
          <div class="flex flex-wrap items-baseline justify-between gap-1">
            <div>
              <a href="/patches/" class="font-bold text-white hover:text-[#ff79c6] no-underline">
                * Linux Kernel Patches
              </a>
              <span class="text-[#00ff66] text-xs ml-1">[6 merged upstream]</span>
            </div>
            <a href="/patches/" class="text-xs text-[#ff79c6] hover:underline font-mono">
              [view patch archives &rarr;]
            </a>
          </div>
          <p class="text-[#c9a6c5] leading-relaxed text-xs sm:text-sm">
            Upstream contributions to ASoC / Intel sound and Thermal / int340x subsystems. Resolved critical hardware clock resource leaks. Reviewed by Mark Brown and Rafael J. Wysocki.
          </p>
        </li>

        <li class="border border-[#2a0e2e] bg-[#100613]/60 p-3 rounded-sm space-y-1">
          <div class="flex flex-wrap items-baseline justify-between gap-1">
            <div>
              <a href="https://github.com/phi5ic/StabiSense" target="_blank" rel="noopener noreferrer" class="font-bold text-white hover:text-[#ff79c6] no-underline">
                * StabiSense
              </a>
              <span class="text-[#bb9af7] text-xs ml-1">[IEEE Thailand 2026]</span>
            </div>
            <a href="https://github.com/phi5ic/StabiSense" target="_blank" rel="noopener noreferrer" class="text-xs text-[#ff79c6] hover:underline font-mono">
              [github &nearr;]
            </a>
          </div>
          <p class="text-[#c9a6c5] leading-relaxed text-xs sm:text-sm">
            Dynamic stabilization for chipsets during high-precision manufacturing. Finalist at Myosa 5.0.
          </p>
        </li>
      </ul>
    </section>

    <!-- Connect -->
    <section class="space-y-2 border-t border-[#2a0e2e] pt-4">
      <div class="text-xs text-[#854d80] uppercase tracking-wider font-bold">
        -- [03] TERMINAL CHANNELS --
      </div>
      <p class="text-xs text-[#c9a6c5] leading-relaxed">
        Feel free to inspect my repositories, read the benchmarks, or get in touch:
      </p>
      <div class="flex flex-wrap items-center gap-3 text-xs pt-1">
        <a href="https://github.com/phi5ic" target="_blank" rel="noopener noreferrer" class="text-[#ff2a85] hover:text-[#ff79c6]">[github]</a>
        <span>&bull;</span>
        <a href="https://www.linkedin.com/in/aravind-anilraj/" target="_blank" rel="noopener noreferrer" class="text-[#ff2a85] hover:text-[#ff79c6]">[linkedin]</a>
        <span>&bull;</span>
        <a href="mailto:aravindanilraj0702@gmail.com" class="text-[#ff2a85] hover:text-[#ff79c6]">[email]</a>
      </div>
    </section>
  </div>
</BaseLayout>
