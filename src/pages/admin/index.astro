---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';
import crypto from 'node:crypto';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login');
}

function computeGitBlobSha(content: Buffer | string): string {
  const buf = Buffer.isBuffer(content) ? content : Buffer.from(content, 'utf8');
  const header = Buffer.from(`blob ${buf.length}\0`, 'utf8');
  return crypto.createHash('sha1').update(Buffer.concat([header, buf])).digest('hex');
}

function getPostSha(postId: string): string {
  try {
    const candidates = [
      path.join(process.cwd(), 'src/content/blog', postId),
      path.join(process.cwd(), 'src/content/blog', `${postId}.md`),
      path.join(process.cwd(), 'src/content/blog', `${postId}.mdx`),
    ];
    for (const c of candidates) {
      if (fs.existsSync(c)) {
        return computeGitBlobSha(fs.readFileSync(c));
      }
    }
    const blogDir = path.join(process.cwd(), 'src/content/blog');
    if (fs.existsSync(blogDir)) {
      const files = fs.readdirSync(blogDir);
      const match = files.find(f => f.toLowerCase().replace(/\.mdx?$/, '') === postId.toLowerCase().replace(/\.mdx?$/, ''));
      if (match) {
        return computeGitBlobSha(fs.readFileSync(path.join(blogDir, match)));
      }
    }
  } catch {}
  return '';
}

const rawPosts = await getCollection('blog');
const posts = rawPosts.map((post) => {
  const sha = getPostSha(post.id);
  return {
    ...post,
    sha,
  };
}).sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);
---

<BaseLayout title="Sysop Console // Admin Dashboard">
  <div class="py-6 sm:py-10 max-w-5xl mx-auto font-mono space-y-6">
    <!-- Top System Header -->
    <header class="border border-[#ff2a85] bg-[#100613] p-4 sm:p-5 rounded-sm shadow-[0_0_16px_rgba(255,42,133,0.2)] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="space-y-1">
        <div class="text-[11px] text-[#854d80] flex items-center gap-2">
          <span class="inline-block w-2 h-2 rounded-full bg-[#00ff66] animate-pulse"></span>
          <span>sysop authenticated // node: workstation.local</span>
        </div>
        <h1 class="text-lg sm:text-xl font-bold text-white tracking-tight flex items-center gap-2">
          <span>CONSOLE // POST MANAGEMENT</span>
          <span class="text-[#ff2a85] text-xs font-normal">[@{user.login}]</span>
        </h1>
      </div>

      <div class="flex items-center gap-3">
        <button
          type="button"
          id="btn-tab-posts"
          class="px-2.5 py-1 rounded-sm border border-[#ff2a85] bg-[#ff2a85]/20 text-white font-bold text-xs cursor-pointer"
        >
          [01] POSTS ARCHIVE ({posts.length})
        </button>
        <button
          type="button"
          id="btn-tab-editor"
          class="px-2.5 py-1 rounded-sm border border-[#2a0e2e] text-[#ff2a85] hover:border-[#ff2a85]/50 hover:bg-[#1a081e] text-xs cursor-pointer"
        >
          [02] NEW POST EDITOR
        </button>
        <form method="POST" action="/api/auth/logout" class="inline">
          <button
            type="submit"
            class="px-2 py-1 rounded-sm border border-[#2a0e2e] text-[#854d80] hover:text-[#ff2a85] hover:border-[#ff2a85]/40 text-xs cursor-pointer"
            title="Terminate session"
          >
            [LOGOUT]
          </button>
        </form>
      </div>
    </header>

    <!-- Global Status Toast Notification -->
    <div id="status-toast" class="hidden p-3 rounded-sm text-xs border"></div>

    <!-- TAB 1: Posts Archive / Management List -->
    <section id="panel-posts" class="space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-[#2a0e2e] pb-2">
        <div class="text-xs text-[#854d80]">
          Total published posts in <span class="text-white">src/content/blog/</span>: {posts.length}
        </div>
        <div class="flex items-center gap-2 text-xs">
          <select
            id="filter-section"
            class="px-2 py-1 bg-[#0d0410] border border-[#2a0e2e] rounded-xs text-xs text-white focus:border-[#ff2a85] outline-none"
          >
            <option value="all">All Sections</option>
            <option value="systems">systems</option>
            <option value="music">music</option>
            <option value="rants">rants</option>
          </select>
          <input
            type="text"
            id="search-posts"
            placeholder="Search posts..."
            class="px-2 py-1 bg-[#0d0410] border border-[#2a0e2e] rounded-xs text-xs text-white focus:border-[#ff2a85] outline-none"
          />
        </div>
      </div>

      <div class="space-y-3" id="post-list-container">
        {posts.map((post) => {
          const postSlug = post.id.replace(/\.mdx?$/, '');
          const formattedDate = new Intl.DateTimeFormat('en-US', {
            year: 'numeric',
            month: '2-digit',
            day: '2-digit',
          }).format(new Date(post.data.date));

          return (
            <div
              class="post-row border border-[#2a0e2e] bg-[#100613]/80 p-3 sm:p-4 rounded-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:border-[#ff2a85]/40 transition-colors"
              data-title={post.data.title.toLowerCase()}
              data-slug={postSlug}
              data-section={post.data.section || 'systems'}
            >
              <div class="space-y-1 min-w-0">
                <div class="flex items-center gap-2">
                  <span class="text-[#ff2a85] text-xs font-bold">&gt;</span>
                  <a href={`/posts/${postSlug}/`} target="_blank" class="text-sm font-bold text-white hover:text-[#ff79c6] no-underline truncate">
                    {post.data.title}
                  </a>
                  {post.data.draft && (
                    <span class="border border-[#ff2a85] text-[#ff2a85] text-[10px] px-1 rounded-xs">[DRAFT]</span>
                  )}
                </div>
                <div class="text-[11px] text-[#854d80] flex flex-wrap items-center gap-2">
                  <span>[{formattedDate}]</span>
                  <span>&bull;</span>
                  <span class="border border-[#2a0e2e] bg-[#070308] px-1 rounded-xs text-[#ff79c6]">
                    section: {post.data.section || 'systems'}
                  </span>
                  {post.data.categories && post.data.categories.length > 0 && (
                    <span>categories: {post.data.categories.join(', ')}</span>
                  )}
                </div>
              </div>

              <div class="flex items-center gap-2 shrink-0">
                <button
                  type="button"
                  class="btn-edit-post px-2 py-1 text-xs border border-[#2a0e2e] hover:border-[#ff2a85] text-[#ff2a85] hover:text-white rounded-xs cursor-pointer"
                  data-post={JSON.stringify({
                    slug: postSlug,
                    sha: post.sha,
                    title: post.data.title,
                    date: new Date(post.data.date).toISOString().split('T')[0],
                    section: post.data.section || 'systems',
                    excerpt: post.data.excerpt || '',
                    teaser: post.data.header?.teaser || '',
                    categories: post.data.categories?.join(', ') || '',
                    tags: post.data.tags?.join(', ') || '',
                    use_math: post.data.use_math || false,
                    draft: post.data.draft || false,
                    body: post.body || '',
                  })}
                >
                  [EDIT]
                </button>
                <a
                  href={`/posts/${postSlug}/`}
                  target="_blank"
                  class="px-2 py-1 text-xs border border-[#2a0e2e] hover:border-[#854d80] text-[#854d80] hover:text-white rounded-xs no-underline"
                >
                  [VIEW ↗]
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- TAB 2: In-Browser Markdown Editor & Live Preview -->
    <section id="panel-editor" class="hidden space-y-4">
      <form id="editor-form" class="space-y-4">
        <!-- Metadata Header Box -->
        <div class="border border-[#2a0e2e] bg-[#100613] p-4 rounded-sm space-y-3">
          <div class="flex items-center justify-between border-b border-[#2a0e2e] pb-2 text-xs">
            <span class="text-[#ff2a85] font-bold">// POST FRONTMATTER SPECIFICATION</span>
            <span id="editor-mode-badge" class="text-[11px] text-[#854d80]">[CREATING NEW POST]</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
            <!-- Title -->
            <div class="space-y-1">
              <label class="text-[#854d80]">Title *</label>
              <input
                type="text"
                id="field-title"
                required
                placeholder="Post title..."
                class="w-full px-2.5 py-1.5 bg-[#070308] border border-[#2a0e2e] focus:border-[#ff2a85] text-white rounded-xs outline-none"
              />
            </div>

            <!-- Slug -->
            <div class="space-y-1">
              <label class="text-[#854d80]">Slug * (URL pathname)</label>
              <input
                type="text"
                id="field-slug"
                required
                pattern="^[a-z0-9]+(?:-[a-z0-9]+)*$"
                placeholder="kebab-case-slug"
                class="w-full px-2.5 py-1.5 bg-[#070308] border border-[#2a0e2e] focus:border-[#ff2a85] text-[#ff79c6] rounded-xs outline-none"
              />
            </div>

            <!-- Section -->
            <div class="space-y-1">
              <label class="text-[#854d80]">Section *</label>
              <select
                id="field-section"
                required
                class="w-full px-2.5 py-1.5 bg-[#070308] border border-[#2a0e2e] focus:border-[#ff2a85] text-white rounded-xs outline-none"
              >
                <option value="systems">systems (Systems &amp; Projects)</option>
                <option value="music">music (Music &amp; Interests)</option>
                <option value="rants">rants (Rants &amp; Hardware)</option>
              </select>
            </div>

            <!-- Date -->
            <div class="space-y-1">
              <label class="text-[#854d80]">Publish Date *</label>
              <input
                type="date"
                id="field-date"
                required
                class="w-full px-2.5 py-1.5 bg-[#070308] border border-[#2a0e2e] focus:border-[#ff2a85] text-white rounded-xs outline-none"
              />
            </div>

            <!-- Teaser Image -->
            <div class="space-y-1 sm:col-span-2">
              <label class="text-[#854d80]">Header Teaser Image (optional image path or URL)</label>
              <input
                type="text"
                id="field-teaser"
                placeholder="/assets/images/posts/sample.jpg"
                class="w-full px-2.5 py-1.5 bg-[#070308] border border-[#2a0e2e] focus:border-[#ff2a85] text-white rounded-xs outline-none"
              />
            </div>
          </div>

          <!-- Excerpt -->
          <div class="space-y-1 text-xs">
            <label class="text-[#854d80]">Excerpt / Summary *</label>
            <textarea
              id="field-excerpt"
              rows="2"
              required
              placeholder="Brief abstract or preview text for cards and feeds..."
              class="w-full px-2.5 py-1.5 bg-[#070308] border border-[#2a0e2e] focus:border-[#ff2a85] text-white rounded-xs outline-none"
            ></textarea>
          </div>

          <!-- Optional taxonomy -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
            <div class="space-y-1">
              <label class="text-[#854d80]">Categories (comma-separated)</label>
              <input
                type="text"
                id="field-categories"
                placeholder="storage, distributed-systems"
                class="w-full px-2.5 py-1.5 bg-[#070308] border border-[#2a0e2e] focus:border-[#ff2a85] text-white rounded-xs outline-none"
              />
            </div>
            <div class="space-y-1">
              <label class="text-[#854d80]">Tags (comma-separated)</label>
              <input
                type="text"
                id="field-tags"
                placeholder="erasure-coding, linux, nifsi"
                class="w-full px-2.5 py-1.5 bg-[#070308] border border-[#2a0e2e] focus:border-[#ff2a85] text-white rounded-xs outline-none"
              />
            </div>
          </div>

          <!-- Flags -->
          <div class="flex flex-wrap items-center gap-6 pt-1 text-xs">
            <label class="flex items-center gap-2 cursor-pointer text-[#ecd2e8]">
              <input type="checkbox" id="field-math" checked class="accent-[#ff2a85]" />
              <span>Enable KaTeX Math (`$..$` and `$$..$$`)</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer text-[#ecd2e8]">
              <input type="checkbox" id="field-draft" class="accent-[#ff2a85]" />
              <span>Save as Draft</span>
            </label>
          </div>
        </div>

        <!-- Editor Toolbar & Metrics -->
        <div class="flex flex-wrap items-center justify-between gap-3 text-xs border-b border-[#2a0e2e] pb-2">
          <div class="flex items-center gap-4 text-[#854d80]">
            <span>Words: <strong id="metric-words" class="text-white">0</strong></span>
            <span>&bull;</span>
            <span>Read time: <strong id="metric-time" class="text-white">1 min</strong></span>
          </div>

          <div class="flex items-center gap-2">
            <button
              type="button"
              id="btn-toggle-view"
              class="px-2 py-0.5 border border-[#2a0e2e] hover:border-[#ff2a85] text-[#ff2a85] rounded-xs cursor-pointer"
            >
              [SPLIT VIEW]
            </button>
          </div>
        </div>

        <!-- Split Workspace: Markdown Input + Live Preview -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 min-h-[420px]" id="editor-workspace">
          <!-- Textarea Input Pane -->
          <div class="flex flex-col space-y-1" id="pane-buffer-col">
            <div class="text-[11px] text-[#854d80] flex items-center justify-between">
              <span>// MARKDOWN BUFFER</span>
              <span class="text-[10px]">UTF-8</span>
            </div>
            <textarea
              id="field-body"
              rows="18"
              placeholder="# Write your post in markdown here...&#10;&#10;Supports headings, code blocks, lists, and KaTeX math:&#10;$$\sum_{i=1}^k \alpha_i \cdot \beta_i = \Omega(N)$$"
              class="w-full flex-1 p-3 bg-[#070308] border border-[#2a0e2e] focus:border-[#ff2a85] text-white font-mono text-xs rounded-xs outline-none resize-y leading-relaxed"
            ></textarea>
          </div>

          <!-- Live Preview Pane -->
          <div class="flex flex-col space-y-1" id="pane-preview-col">
            <div class="text-[11px] text-[#854d80] flex items-center justify-between">
              <span>// COMPILED PREVIEW</span>
              <span class="text-[#ff2a85] text-[10px]">[LIVE]</span>
            </div>
            <div
              id="preview-pane"
              class="w-full flex-1 p-3 bg-[#0d0410] border border-[#2a0e2e] rounded-xs overflow-y-auto prose-minimal max-h-[500px]"
            >
              <p class="text-[#854d80] text-xs">// Live preview will render here...</p>
            </div>
          </div>
        </div>

        <!-- Publish Action Footer -->
        <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-[#2a0e2e]">
          <button
            type="button"
            id="btn-cancel-edit"
            class="px-3 py-1.5 border border-[#2a0e2e] hover:border-[#ff2a85] text-[#854d80] hover:text-white rounded-xs text-xs cursor-pointer"
          >
            [CANCEL / RESET]
          </button>

          <button
            type="submit"
            id="btn-publish"
            class="px-4 py-2 border border-[#ff2a85] bg-[#ff2a85]/20 hover:bg-[#ff2a85]/30 text-white font-bold rounded-sm shadow-[0_0_12px_rgba(255,42,133,0.3)] transition-all cursor-pointer text-xs"
          >
            [✓ PUBLISH &amp; COMMIT DIRECTLY TO GITHUB]
          </button>
        </div>
      </form>
    </section>
  </div>

  <script>
    import katex from 'katex';
    import { calculateMetrics } from '../../utils/metrics';

    function deriveSlug(text: string): string {
      return text
        .toLowerCase()
        .trim()
        .replace(/[^\w\s-]/g, '')
        .replace(/[\s_-]+/g, '-')
        .replace(/^-+|-+$/g, '');
    }

    function escapeHtml(str: string): string {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function parseInline(str: string): string {
      return str
        .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
        .replace(/__([^_]+)__/g, '<strong>$1</strong>')
        .replace(/\*([^*]+)\*/g, '<em>$1</em>')
        .replace(/_([^_]+)_/g, '<em>$1</em>')
        .replace(/~~([^~]+)~~/g, '<del>$1</del>');
    }

    function renderMarkdownAndMath(rawText: string, enableMath: boolean): string {
      if (!rawText || !rawText.trim()) {
        return '<p class="text-[#854d80] text-xs">// Live preview will render here...</p>';
      }

      const tokens: Record<string, string> = {};
      let tokenCounter = 0;
      function saveToken(html: string): string {
        const key = `@@TOKEN_${tokenCounter++}@@`;
        tokens[key] = html;
        return key;
      }

      let text = rawText;

      // 1. Fenced code blocks
      text = text.replace(/```([a-zA-Z0-9_-]*)\n([\s\S]*?)```/g, (_match, lang, code) => {
        const langAttr = lang ? ` class="language-${escapeHtml(lang)}"` : '';
        return saveToken(`<pre><code${langAttr}>${escapeHtml(code)}</code></pre>`);
      });

      // 2. KaTeX math (if enabled)
      if (enableMath) {
        // Block math $$ ... $$
        text = text.replace(/\$\$([\s\S]*?)\$\$/g, (_match, expr) => {
          try {
            const rendered = katex.renderToString(expr.trim(), {
              displayMode: true,
              throwOnError: false,
            });
            return saveToken(rendered);
          } catch (err: any) {
            return saveToken(`<pre class="text-[#ff2a85]">KaTeX Error: ${escapeHtml(err.message)}</pre>`);
          }
        });

        // Inline math $ ... $
        text = text.replace(/\$([^$\n]+?)\$/g, (_match, expr) => {
          try {
            const rendered = katex.renderToString(expr.trim(), {
              displayMode: false,
              throwOnError: false,
            });
            return saveToken(rendered);
          } catch (err: any) {
            return saveToken(`<span class="text-[#ff2a85]">KaTeX Error: ${escapeHtml(err.message)}</span>`);
          }
        });
      }

      // 3. Inline code `code`
      text = text.replace(/`([^`\n]+)`/g, (_match, code) => {
        return saveToken(`<code>${escapeHtml(code)}</code>`);
      });

      // Isolate headings to separate blocks
      text = text.replace(/^(#{1,6}\s+[^\n]+)$/gm, '\n\n$1\n\n');

      const rawBlocks = text.split(/\n{2,}/);
      const renderedBlocks: string[] = [];

      for (let block of rawBlocks) {
        block = block.trim();
        if (!block) continue;

        if (/^@@TOKEN_\d+@@$/.test(block)) {
          renderedBlocks.push(block);
          continue;
        }

        // Headings
        const headingMatch = block.match(/^(#{1,6})\s+(.+)$/m);
        if (headingMatch && block.startsWith(headingMatch[1])) {
          const level = headingMatch[1].length;
          const title = headingMatch[2].trim();
          const slug = deriveSlug(title);
          renderedBlocks.push(`<h${level} id="${slug}">${parseInline(title)}</h${level}>`);
          continue;
        }

        // Blockquotes
        if (block.startsWith('>')) {
          const quoteContent = block
            .split('\n')
            .map((line) => line.replace(/^>\s?/, ''))
            .join('\n');
          renderedBlocks.push(`<blockquote>${parseInline(quoteContent)}</blockquote>`);
          continue;
        }

        // Tables
        const lines = block.split('\n').map((l) => l.trim());
        if (
          lines.length >= 2 &&
          lines[0].startsWith('|') && lines[0].endsWith('|') &&
          lines[1].startsWith('|') && lines[1].endsWith('|') &&
          /^[\|\s\-:]+$/.test(lines[1])
        ) {
          const headerCells = lines[0]
            .slice(1, -1)
            .split('|')
            .map((c) => parseInline(c.trim()));
          const thead = `<thead><tr>${headerCells.map((c) => `<th>${c}</th>`).join('')}</tr></thead>`;
          const bodyRows: string[] = [];
          for (let i = 2; i < lines.length; i++) {
            if (!lines[i].startsWith('|')) continue;
            const rowCells = lines[i]
              .slice(1, -1)
              .split('|')
              .map((c) => parseInline(c.trim()));
            bodyRows.push(`<tr>${rowCells.map((c) => `<td>${c}</td>`).join('')}</tr>`);
          }
          renderedBlocks.push(`<table>${thead}<tbody>${bodyRows.join('')}</tbody></table>`);
          continue;
        }

        // Unordered lists
        if (lines.every((l) => /^[-*]\s+/.test(l))) {
          const items = lines.map((l) => `<li>${parseInline(l.replace(/^[-*]\s+/, ''))}</li>`);
          renderedBlocks.push(`<ul>${items.join('')}</ul>`);
          continue;
        }

        // Ordered lists
        if (lines.every((l) => /^\d+\.\s+/.test(l))) {
          const items = lines.map((l) => `<li>${parseInline(l.replace(/^\d+\.\s+/, ''))}</li>`);
          renderedBlocks.push(`<ol>${items.join('')}</ol>`);
          continue;
        }

        // Standard paragraph
        const parsedLines = lines.map((l) => parseInline(l)).join('<br />');
        renderedBlocks.push(`<p class="my-2 leading-relaxed">${parsedLines}</p>`);
      }

      let finalHtml = renderedBlocks.join('\n');
      for (const [key, replacement] of Object.entries(tokens)) {
        finalHtml = finalHtml.replaceAll(key, replacement);
      }
      return finalHtml;
    }

    function validateEditorPost(data: {
      title: string;
      slug: string;
      date: string;
      section: string;
      excerpt: string;
    }) {
      const issues: { field: string; message: string }[] = [];

      if (!data.title || typeof data.title !== 'string' || !data.title.trim()) {
        issues.push({ field: 'title', message: 'Title is required and cannot be empty.' });
      }

      const slugRegex = /^[a-z0-9]+(?:-[a-z0-9]+)*$/;
      if (!data.slug || typeof data.slug !== 'string' || !data.slug.trim()) {
        issues.push({ field: 'slug', message: 'Slug is required and cannot be empty.' });
      } else if (!slugRegex.test(data.slug.trim())) {
        issues.push({
          field: 'slug',
          message: 'Invalid slug format. Must be lowercase kebab-case (e.g. my-post-name), containing only lowercase alphanumeric characters and single hyphens.',
        });
      }

      const validSections = ['systems', 'music', 'rants'];
      if (!data.section || !validSections.includes(data.section)) {
        issues.push({
          field: 'section',
          message: 'Invalid section. Must be one of: systems, music, rants.',
        });
      }

      if (!data.date || isNaN(Date.parse(data.date))) {
        issues.push({
          field: 'date',
          message: 'Publish date must be a valid date representation (YYYY-MM-DD).',
        });
      }

      if (!data.excerpt || typeof data.excerpt !== 'string' || !data.excerpt.trim()) {
        issues.push({ field: 'excerpt', message: 'Excerpt is required and cannot be empty.' });
      }

      return {
        valid: issues.length === 0,
        issues,
      };
    }

    function initAdminDashboard() {
      const editorForm = document.getElementById('editor-form') as HTMLFormElement | null;
      if (!editorForm) return;
      if (editorForm.dataset.initialized === 'true') return;
      editorForm.dataset.initialized = 'true';

      // Tab Navigation Elements
      const btnTabPosts = document.getElementById('btn-tab-posts');
      const btnTabEditor = document.getElementById('btn-tab-editor');
      const panelPosts = document.getElementById('panel-posts');
      const panelEditor = document.getElementById('panel-editor');

      // Form Elements
      const titleInput = document.getElementById('field-title') as HTMLInputElement | null;
      const slugInput = document.getElementById('field-slug') as HTMLInputElement | null;
      const sectionInput = document.getElementById('field-section') as HTMLSelectElement | null;
      const dateInput = document.getElementById('field-date') as HTMLInputElement | null;
      const teaserInput = document.getElementById('field-teaser') as HTMLInputElement | null;
      const excerptInput = document.getElementById('field-excerpt') as HTMLTextAreaElement | null;
      const categoriesInput = document.getElementById('field-categories') as HTMLInputElement | null;
      const tagsInput = document.getElementById('field-tags') as HTMLInputElement | null;
      const mathCheckbox = document.getElementById('field-math') as HTMLInputElement | null;
      const draftCheckbox = document.getElementById('field-draft') as HTMLInputElement | null;
      const bodyInput = document.getElementById('field-body') as HTMLTextAreaElement | null;

      const previewPane = document.getElementById('preview-pane');
      const metricWords = document.getElementById('metric-words');
      const metricTime = document.getElementById('metric-time');
      const statusToast = document.getElementById('status-toast');
      const editorModeBadge = document.getElementById('editor-mode-badge');
      const searchInput = document.getElementById('search-posts') as HTMLInputElement | null;
      const filterSectionSelect = document.getElementById('filter-section') as HTMLSelectElement | null;

      const btnCancelEdit = document.getElementById('btn-cancel-edit');
      const btnToggleView = document.getElementById('btn-toggle-view');
      const editorWorkspace = document.getElementById('editor-workspace');
      const paneBuffer = document.getElementById('pane-buffer-col');
      const panePreview = document.getElementById('pane-preview-col');

      let currentEditingSha: string | null = null;
      let manualSlugEdited = false;

      // Set default date to today
      if (dateInput && !dateInput.value) {
        dateInput.value = new Date().toISOString().split('T')[0];
      }

      // Switch to Archive Tab
      function showPostsTab() {
        if (panelPosts) panelPosts.classList.remove('hidden');
        if (panelEditor) panelEditor.classList.add('hidden');
        if (btnTabPosts) {
          btnTabPosts.classList.remove('border-[#2a0e2e]', 'text-[#ff2a85]');
          btnTabPosts.classList.add('border-[#ff2a85]', 'bg-[#ff2a85]/20', 'text-white', 'font-bold');
        }
        if (btnTabEditor) {
          btnTabEditor.classList.remove('border-[#ff2a85]', 'bg-[#ff2a85]/20', 'text-white', 'font-bold');
          btnTabEditor.classList.add('border-[#2a0e2e]', 'text-[#ff2a85]');
        }
      }

      // Switch to Editor Tab
      function showEditorTab(modeText = '[CREATING NEW POST]') {
        if (panelEditor) panelEditor.classList.remove('hidden');
        if (panelPosts) panelPosts.classList.add('hidden');
        if (btnTabEditor) {
          btnTabEditor.classList.remove('border-[#2a0e2e]', 'text-[#ff2a85]');
          btnTabEditor.classList.add('border-[#ff2a85]', 'bg-[#ff2a85]/20', 'text-white', 'font-bold');
        }
        if (btnTabPosts) {
          btnTabPosts.classList.remove('border-[#ff2a85]', 'bg-[#ff2a85]/20', 'text-white', 'font-bold');
          btnTabPosts.classList.add('border-[#2a0e2e]', 'text-[#ff2a85]');
        }
        if (editorModeBadge) editorModeBadge.textContent = modeText;
      }

      if (btnTabPosts) btnTabPosts.onclick = showPostsTab;
      if (btnTabEditor) {
        btnTabEditor.onclick = () => {
          resetEditor();
          showEditorTab();
        };
      }

      // Reset editor
      function resetEditor() {
        currentEditingSha = null;
        manualSlugEdited = false;
        editorForm?.reset();
        if (teaserInput) teaserInput.value = '';
        if (dateInput) dateInput.value = new Date().toISOString().split('T')[0];
        if (editorModeBadge) editorModeBadge.textContent = '[CREATING NEW POST]';
        updatePreview();
      }

      // Slug Auto-Derivation
      if (titleInput && slugInput) {
        titleInput.addEventListener('input', () => {
          if (!manualSlugEdited) {
            slugInput.value = deriveSlug(titleInput.value);
          }
        });
        slugInput.addEventListener('input', () => {
          manualSlugEdited = true;
        });
      }

      // Live Preview & Word Count
      function updatePreview() {
        const text = bodyInput?.value || '';
        const { wordCount, readTimeMinutes } = calculateMetrics(text);

        if (metricWords) metricWords.textContent = String(wordCount);
        if (metricTime) metricTime.textContent = `${readTimeMinutes} min`;

        if (previewPane) {
          const enableMath = mathCheckbox ? mathCheckbox.checked : true;
          previewPane.innerHTML = renderMarkdownAndMath(text, enableMath);
        }
      }

      if (bodyInput) {
        bodyInput.addEventListener('input', updatePreview);
      }
      if (mathCheckbox) {
        mathCheckbox.addEventListener('change', updatePreview);
      }

      // Initial preview update
      updatePreview();

      // Search and Section Filter
      function filterPosts() {
        const q = searchInput ? searchInput.value.toLowerCase().trim() : '';
        const sectionFilter = filterSectionSelect ? filterSectionSelect.value : 'all';

        document.querySelectorAll('.post-row').forEach((row) => {
          const title = (row.getAttribute('data-title') || '').toLowerCase();
          const slug = (row.getAttribute('data-slug') || '').toLowerCase();
          const section = (row.getAttribute('data-section') || '').toLowerCase();

          const matchesQuery = !q || title.includes(q) || slug.includes(q) || section.includes(q);
          const matchesSection = sectionFilter === 'all' || section === sectionFilter;

          if (matchesQuery && matchesSection) {
            (row as HTMLElement).style.display = 'flex';
          } else {
            (row as HTMLElement).style.display = 'none';
          }
        });
      }

      if (searchInput) searchInput.addEventListener('input', filterPosts);
      if (filterSectionSelect) filterSectionSelect.addEventListener('change', filterPosts);

      // Cancel / Reset Button
      if (btnCancelEdit) {
        btnCancelEdit.addEventListener('click', () => {
          resetEditor();
          showPostsTab();
        });
      }

      // Toggle Split View Button
      let viewModeIndex = 0;
      const viewModes = [
        { label: '[SPLIT VIEW]', buffer: true, preview: true },
        { label: '[EDITOR ONLY]', buffer: true, preview: false },
        { label: '[PREVIEW ONLY]', buffer: false, preview: true },
      ];
      if (btnToggleView) {
        btnToggleView.addEventListener('click', () => {
          viewModeIndex = (viewModeIndex + 1) % viewModes.length;
          const mode = viewModes[viewModeIndex];
          btnToggleView.textContent = mode.label;
          if (paneBuffer) paneBuffer.classList.toggle('hidden', !mode.buffer);
          if (panePreview) panePreview.classList.toggle('hidden', !mode.preview);
          if (editorWorkspace) {
            if (mode.buffer && mode.preview) {
              editorWorkspace.className = 'grid grid-cols-1 lg:grid-cols-2 gap-4 min-h-[420px]';
            } else {
              editorWorkspace.className = 'grid grid-cols-1 gap-4 min-h-[420px]';
            }
          }
        });
      }

      // Edit Post Button Clicks
      document.querySelectorAll('.btn-edit-post').forEach((btn) => {
        btn.addEventListener('click', () => {
          const postData = JSON.parse(btn.getAttribute('data-post') || '{}');
          currentEditingSha = postData.sha || null;
          if (titleInput) titleInput.value = postData.title || '';
          if (slugInput) slugInput.value = postData.slug || '';
          if (sectionInput) sectionInput.value = postData.section || 'systems';
          if (dateInput) dateInput.value = postData.date || '';
          if (excerptInput) excerptInput.value = postData.excerpt || '';
          if (teaserInput) teaserInput.value = postData.teaser || '';
          if (categoriesInput) categoriesInput.value = postData.categories || '';
          if (tagsInput) tagsInput.value = postData.tags || '';
          if (mathCheckbox) mathCheckbox.checked = postData.use_math ?? false;
          if (draftCheckbox) draftCheckbox.checked = postData.draft ?? false;
          if (bodyInput) bodyInput.value = postData.body || '';

          manualSlugEdited = true;
          showEditorTab(`[EDITING: ${postData.slug}]${currentEditingSha ? ` (SHA: ${currentEditingSha.slice(0, 7)})` : ''}`);
          updatePreview();
        });
      });

      // Submit / Publish Flow with Pre-Commit Schema Validation
      editorForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        const titleVal = titleInput ? titleInput.value.trim() : '';
        const slugVal = slugInput ? slugInput.value.trim() : '';
        const dateVal = dateInput ? dateInput.value : '';
        const sectionVal = sectionInput ? sectionInput.value : '';
        const excerptVal = excerptInput ? excerptInput.value.trim() : '';
        const teaserVal = teaserInput ? teaserInput.value.trim() : '';

        // Feature 19: Pre-commit In-Browser Schema Validation
        const validation = validateEditorPost({
          title: titleVal,
          slug: slugVal,
          date: dateVal,
          section: sectionVal,
          excerpt: excerptVal,
        });

        if (!validation.valid) {
          if (statusToast) {
            statusToast.className =
              'p-3 rounded-sm text-xs border border-[#ff2a85] bg-[#ff2a85]/15 text-[#ff79c6] shadow-[0_0_12px_rgba(255,42,133,0.3)] space-y-1.5';
            statusToast.innerHTML = `
              <div class="font-bold text-[#ff2a85] flex items-center gap-2">
                <span class="inline-block w-2 h-2 rounded-full bg-[#ff2a85] animate-ping"></span>
                <span>! SCHEMA VALIDATION FAILED // PRE-COMMIT REJECTION</span>
              </div>
              <ul class="list-disc list-inside space-y-0.5 text-white/90">
                ${validation.issues.map((i) => `<li><code class="text-[#ff79c6]">[${i.field}]</code>: ${i.message}</li>`).join('')}
              </ul>
            `;
            statusToast.classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
          }
          return;
        }

        const btnPublish = document.getElementById('btn-publish') as HTMLButtonElement | null;
        if (btnPublish) {
          btnPublish.disabled = true;
          btnPublish.textContent = '[ COMMITTING TO GITHUB... ]';
        }

        const payload = {
          slug: slugVal,
          frontmatter: {
            title: titleVal,
            date: dateVal,
            section: sectionVal,
            excerpt: excerptVal,
            ...(teaserVal ? { header: { teaser: teaserVal } } : {}),
            categories: categoriesInput ? categoriesInput.value.split(',').map((s) => s.trim()).filter(Boolean) : [],
            tags: tagsInput ? tagsInput.value.split(',').map((s) => s.trim()).filter(Boolean) : [],
            use_math: mathCheckbox ? mathCheckbox.checked : false,
            draft: draftCheckbox ? draftCheckbox.checked : false,
          },
          body: bodyInput ? bodyInput.value : '',
          sha: currentEditingSha,
        };

        try {
          const res = await fetch('/api/publish', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          const data = await res.json();
          if (res.ok && data.success) {
            if (statusToast) {
              statusToast.className =
                'p-3 rounded-sm text-xs border border-[#00ff66] bg-[#00ff66]/15 text-[#00ff66] shadow-[0_0_12px_rgba(0,255,102,0.3)]';
              statusToast.innerHTML = `✓ POST PUBLISHED: Successfully committed to main branch! Commit SHA: <code>${data.commit?.sha?.slice(0, 7) || 'HEAD'}</code>. Automated CI/CD will deploy changes to gh-pages momentarily.`;
              statusToast.classList.remove('hidden');
              window.scrollTo({ top: 0, behavior: 'smooth' });
            }
          } else {
            if (statusToast) {
              statusToast.className =
                'p-3 rounded-sm text-xs border border-[#ff2a85] bg-[#ff2a85]/15 text-[#ff79c6] shadow-[0_0_12px_rgba(255,42,133,0.3)]';
              statusToast.innerHTML = `! PUBLISH ERROR: ${data.message || data.error || 'Failed to commit post.'}`;
              statusToast.classList.remove('hidden');
            }
          }
        } catch (err: any) {
          if (statusToast) {
            statusToast.className = 'p-3 rounded-sm text-xs border border-[#ff2a85] bg-[#ff2a85]/15 text-[#ff79c6]';
            statusToast.innerHTML = `! NETWORK ERROR: ${err.message}`;
            statusToast.classList.remove('hidden');
          }
        } finally {
          if (btnPublish) {
            btnPublish.disabled = false;
            btnPublish.textContent = '[✓ PUBLISH & COMMIT DIRECTLY TO GITHUB]';
          }
        }
      });
    }

    // Mount listeners
    document.addEventListener('astro:page-load', () => {
      const form = document.getElementById('editor-form');
      if (form) form.removeAttribute('data-initialized');
      initAdminDashboard();
    });
    if (document.readyState !== 'loading') {
      initAdminDashboard();
    } else {
      document.addEventListener('DOMContentLoaded', initAdminDashboard);
    }
  </script>
</BaseLayout>
