---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout
  title="Writing — Aravind Anilraj (phi5ic)"
  description="Technical writing and benchmarks on storage architecture, erasure coding, and Linux internals."
>
  <div class="space-y-8">
    <header class="border-b border-[#292e42] pb-3">
      <h1 class="text-xl font-bold text-white tracking-tight">Writing</h1>
      <p class="text-xs text-[#565f89] mt-1">Deep dives, benchmarks, and notes on systems engineering.</p>
    </header>

    <div class="space-y-6">
      {posts.map((post) => {
        const postSlug = post.id.replace(/\.mdx?$/, '');
        const formattedDate = new Intl.DateTimeFormat('en-US', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
        }).format(post.data.date);

        return (
          <article class="space-y-1">
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
              <a
                href={`/posts/${postSlug}/`}
                class="text-base font-semibold text-white hover:text-[#7dcfff] no-underline"
              >
                {post.data.title}
              </a>
              <time datetime={post.data.date.toISOString()} class="text-xs text-[#565f89] shrink-0">
                {formattedDate}
              </time>
            </div>
            <p class="text-sm text-[#9aa5ce] leading-relaxed">
              {post.data.excerpt}
            </p>
          </article>
        );
      })}
    </div>
  </div>
</BaseLayout>
