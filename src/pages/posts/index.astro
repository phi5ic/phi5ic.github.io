---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout
  title="Writing — Aravind Anilraj (phi5ic)"
  description="Technical writing and benchmarks on storage architecture, erasure coding, and Linux internals."
>
  <div class="space-y-10 font-mono">
    <!-- Header -->
    <header class="border border-[#2a0e2e] bg-[#100613] p-4 sm:p-5 rounded-sm space-y-1">
      <div class="text-[11px] text-[#854d80]">phi5ic@mesh ~ $ ls -la /posts/</div>
      <h1 class="text-lg sm:text-xl font-bold text-white tracking-tight flex items-center gap-2">
        <span>Writing &amp; Postmortems</span>
        <span class="text-[#ff2a85] text-xs font-normal">[{posts.length} entries]</span>
      </h1>
      <p class="text-xs text-[#c9a6c5]">
        Architecture writeups, empirical benchmarks, and systems engineering postmortems.
      </p>
    </header>

    <div class="space-y-6">
      {posts.map((post) => {
        const postSlug = post.id.replace(/\.mdx?$/, '');
        const formattedDate = new Intl.DateTimeFormat('en-US', {
          year: 'numeric',
          month: '2-digit',
          day: '2-digit',
        }).format(post.data.date);

        return (
          <article class="border border-[#2a0e2e] bg-[#100613]/70 p-4 rounded-sm space-y-2 group">
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
              <a
                href={`/posts/${postSlug}/`}
                class="text-sm sm:text-base font-bold text-white group-hover:text-[#ff79c6] no-underline"
              >
                &gt; {post.data.title}
              </a>
              <time datetime={post.data.date.toISOString()} class="text-xs text-[#854d80] shrink-0 font-mono">
                [{formattedDate}]
              </time>
            </div>
            <p class="text-xs sm:text-sm text-[#ecd2e8] leading-relaxed">
              {post.data.excerpt}
            </p>
            <div class="flex flex-wrap items-center gap-3 text-xs pt-2 border-t border-[#2a0e2e] text-[#ff2a85]">
              <a href={`/posts/${postSlug}/`} class="hover:text-[#ff79c6]">[read article &rarr;]</a>
              {post.data.categories && post.data.categories.length > 0 && (
                <span class="text-[#854d80]">category: {post.data.categories.join('/')}</span>
              )}
            </div>
          </article>
        );
      })}
    </div>
  </div>
</BaseLayout>
