---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout
  title="Writing — Aravind Anilraj (phi5ic)"
  description="Technical writing, benchmarks, and research on storage architecture, erasure coding, and distributed operating systems."
>
  <div class="max-w-4xl mx-auto py-8 sm:py-14">
    <!-- Header -->
    <header class="mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium text-[#7dcfff] bg-[#7dcfff]/10 border border-[#7dcfff]/20 mb-4">
        Archive &bull; {posts.length} {posts.length === 1 ? 'Article' : 'Articles'}
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-4">
        Writing & Deep Dives
      </h1>
      <p class="text-base sm:text-lg text-[#9aa5ce] max-w-2xl leading-relaxed">
        Technical investigations, microbenchmarks, and postmortems on storage architectures, erasure coding, Linux systems, and distributed computing.
      </p>
    </header>

    <!-- Posts Grid / List -->
    <div class="space-y-6">
      {posts.map((post) => {
        const postSlug = post.id.replace(/\.mdx?$/, '');
        const formattedDate = new Intl.DateTimeFormat('en-US', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
        }).format(post.data.date);

        return (
          <a
            href={`/posts/${postSlug}/`}
            class="glass-card block p-6 sm:p-8 group relative overflow-hidden"
          >
            <!-- Ambient Card Glow Accent -->
            <div class="absolute -right-20 -top-20 w-48 h-48 bg-[#7aa2f7]/10 rounded-full blur-3xl group-hover:bg-[#7dcfff]/20 transition-all duration-500"></div>

            <div class="relative z-10">
              <div class="flex flex-wrap items-center gap-3 text-xs text-[#565f89] mb-3">
                <time datetime={post.data.date.toISOString()} class="text-[#7aa2f7] font-mono">
                  {formattedDate}
                </time>
                <span>&bull;</span>
                <span class="text-[#9aa5ce]">
                  {Math.max(1, Math.round((post.body || '').split(/\s+/).length / 200))} min read
                </span>
                {post.data.categories && post.data.categories.length > 0 && (
                  <div class="flex items-center gap-1.5 ml-auto">
                    {post.data.categories.map((cat: string) => (
                      <span class="px-2.5 py-0.5 rounded-full bg-white/5 text-[#bb9af7] border border-white/5 font-mono text-[11px]">
                        {cat}
                      </span>
                    ))}
                  </div>
                )}
              </div>

              <h2 class="text-xl sm:text-2xl font-bold text-white group-hover:text-[#7dcfff] transition-colors mb-3 leading-snug">
                {post.data.title}
              </h2>

              <p class="text-sm sm:text-base text-[#9aa5ce] line-clamp-3 leading-relaxed mb-4">
                {post.data.excerpt}
              </p>

              <div class="flex items-center text-xs font-semibold text-[#7aa2f7] group-hover:text-[#7dcfff] transition-colors">
                <span>Read article</span>
                <span class="ml-1.5 transition-transform group-hover:translate-x-1">&rarr;</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>
