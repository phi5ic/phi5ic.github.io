                </a>
              </td>
              <td class="py-3 px-3.5 whitespace-nowrap text-xs">
                <a href="https://patch.msgid.link/20260401220507.23557-4-aravindanilraj0702@gmail.com" target="_blank" rel="noopener noreferrer" class="text-[#7aa2f7] hover:underline">
                  lore &nearr;
                </a>
              </td>
              <td class="py-3 px-3.5 text-[#9ece6a] whitespace-nowrap font-mono text-xs">5.10+</td>
            </tr>
            <tr class="hover:bg-[#1a1b26]/50 transition-colors">
              <td class="py-3 px-3.5 text-[#c0caf5] font-medium">ASoC: Standardize MCLK error logs across RT boards</td>
              <td class="py-3 px-3.5 text-[#a9b1d6] whitespace-nowrap">ASoC / Intel</td>
