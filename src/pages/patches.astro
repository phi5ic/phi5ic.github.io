                </a>
              </td>
              <td class="py-3 px-3.5 whitespace-nowrap text-xs">
                <a href="https://patch.msgid.link/20260329070642.10721-3-aravindanilraj0702@gmail.com" target="_blank" rel="noopener noreferrer" class="text-[#7aa2f7] hover:underline">
