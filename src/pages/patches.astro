              <td class="py-3 px-3.5 text-[#a9b1d6] whitespace-nowrap">ASoC / Intel</td>
              <td class="py-3 px-3.5 whitespace-nowrap font-mono text-xs">
                <a href="https://git.kernel.org/pub/scm/linux/kernel/git/broonie/sound.git/commit/?id=dced5a373a96" target="_blank" rel="noopener noreferrer" class="text-[#7dcfff] hover:underline">
