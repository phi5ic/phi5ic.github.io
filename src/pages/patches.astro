---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Kernel Contributions — Aravind Anilraj (phi5ic)"
  description="Patches submitted to the Linux kernel upstream across sound and thermal subsystems."
>
  <div class="space-y-10">
    <header class="border-b border-[#292e42] pb-3">
      <h1 class="text-xl font-bold text-white tracking-tight">Kernel Contributions</h1>
      <p class="text-sm text-[#7aa2f7] mt-1">
        Patches submitted and merged into the upstream Linux kernel.
      </p>
    </header>

    <!-- Verification / Archive links -->
    <section class="bg-[#1a1b26] border border-[#292e42] rounded-md p-4 text-xs text-[#a9b1d6] space-y-2">
      <div class="text-white font-semibold">Upstream Verification &amp; Public Archives:</div>
      <div class="flex flex-wrap gap-x-5 gap-y-2 text-[#7aa2f7]">
        <a href="https://git.kernel.org/pub/scm/linux/kernel/git/broonie/sound.git/log/?qt=author&q=Aravind+Anilraj" target="_blank" rel="noopener noreferrer" class="hover:text-[#7dcfff]">
          &bull; broonie/sound.git author commits &nearr;
        </a>
        <a href="https://git.kernel.org/pub/scm/linux/kernel/git/rafael/linux-pm.git/log/?qt=author&q=Aravind+Anilraj" target="_blank" rel="noopener noreferrer" class="hover:text-[#7dcfff]">
          &bull; rafael/linux-pm.git author commits &nearr;
        </a>
        <a href="https://lore.kernel.org/all/?q=f%3A%22Aravind+Anilraj%22" target="_blank" rel="noopener noreferrer" class="hover:text-[#7dcfff]">
          &bull; lore.kernel.org mail archive search &nearr;
        </a>
      </div>
    </section>

    <!-- Merged Patches Table -->
    <section class="space-y-4">
      <div class="flex items-center justify-between border-b border-[#292e42] pb-2">
        <h2 class="text-xs uppercase tracking-wider text-[#565f89] font-medium">
          merged patches
        </h2>
        <span class="text-xs text-[#9ece6a] font-mono">6 patches</span>
      </div>

      <div class="overflow-x-auto border border-[#292e42] rounded">
        <table class="w-full text-left text-sm border-collapse">
          <thead>
            <tr class="bg-[#1a1b26] border-b border-[#292e42] text-xs uppercase tracking-wider text-[#7aa2f7]">
              <th class="py-2.5 px-3.5 font-semibold">Patch Description</th>
              <th class="py-2.5 px-3.5 font-semibold">Subsystem</th>
              <th class="py-2.5 px-3.5 font-semibold">Git Commit</th>
              <th class="py-2.5 px-3.5 font-semibold">Lore Thread</th>
              <th class="py-2.5 px-3.5 font-semibold whitespace-nowrap">Backport</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#292e42] text-xs sm:text-sm">
            <tr class="hover:bg-[#1a1b26]/50 transition-colors">
              <td class="py-3 px-3.5 text-[#c0caf5] font-medium">ASoC: bytcr_rt5640: fix MCLK resource leak</td>
              <td class="py-3 px-3.5 text-[#a9b1d6] whitespace-nowrap">ASoC / Intel</td>
              <td class="py-3 px-3.5 whitespace-nowrap font-mono text-xs">
                <a href="https://git.kernel.org/pub/scm/linux/kernel/git/broonie/sound.git/commit/?id=a02496a29463" target="_blank" rel="noopener noreferrer" class="text-[#7dcfff] hover:underline">
                  a02496a29463 &nearr;
                </a>
              </td>
              <td class="py-3 px-3.5 whitespace-nowrap text-xs">
                <a href="https://patch.msgid.link/20260401220507.23557-2-aravindanilraj0702@gmail.com" target="_blank" rel="noopener noreferrer" class="text-[#7aa2f7] hover:underline">
                  lore &nearr;
                </a>
              </td>
              <td class="py-3 px-3.5 text-[#9ece6a] whitespace-nowrap font-mono text-xs">5.10+</td>
            </tr>
            <tr class="hover:bg-[#1a1b26]/50 transition-colors">
              <td class="py-3 px-3.5 text-[#c0caf5] font-medium">ASoC: bytcr_rt5651: fix MCLK resource leak</td>
              <td class="py-3 px-3.5 text-[#a9b1d6] whitespace-nowrap">ASoC / Intel</td>
              <td class="py-3 px-3.5 whitespace-nowrap font-mono text-xs">
                <a href="https://git.kernel.org/pub/scm/linux/kernel/git/broonie/sound.git/commit/?id=b022e5c142ef" target="_blank" rel="noopener noreferrer" class="text-[#7dcfff] hover:underline">
