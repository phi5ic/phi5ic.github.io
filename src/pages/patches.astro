    <!-- Reviewers & Maintainers -->
    <section class="space-y-3">
      <h2 class="text-xs uppercase tracking-wider text-[#565f89] font-medium border-b border-[#292e42] pb-2">
        reviewers &amp; maintainers
      </h2>
      <ul class="space-y-2 text-sm text-[#a9b1d6] list-disc pl-5">
        <li>
          <strong class="text-white">Mark Brown</strong> <span class="text-[#565f89]">&mdash; ASoC subsystem maintainer (Signed-off-by, committed to sound.git)</span>
        </li>
        <li>
          <strong class="text-white">Cezary Rojewski</strong> <span class="text-[#565f89]">&mdash; Intel ASoC driver lead (Reviewed-by)</span>
        </li>
        <li>
          <strong class="text-white">Rafael J. Wysocki</strong> <span class="text-[#565f89]">&mdash; Linux Power Management &amp; Thermal maintainer (Signed-off-by, committed to linux-pm.git)</span>
        </li>
      </ul>
    </section>
