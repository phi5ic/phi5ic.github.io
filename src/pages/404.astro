---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Not Found">
  <div class="py-20 text-center space-y-4 font-mono">
    <h1 class="text-4xl font-bold text-white">404</h1>
    <p class="text-sm text-[#9aa5ce]">Not found.</p>
    <div class="pt-2">
      <a href="/" class="text-xs text-[#7aa2f7] hover:text-[#7dcfff]">
        &larr; return home
      </a>
    </div>
  </div>
</BaseLayout>
