---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Strand Not Found">
  <div class="py-20 text-center space-y-4 font-mono">
    <div class="text-xs text-[#854d80]">phi5ic@mesh ~ $ stat /target</div>
    <h1 class="text-3xl font-bold text-[#ff2a85] tracking-tight">404 :: ENOENT</h1>
    <p class="text-xs text-[#c9a6c5]">No such file or directory. Strand broken or missing.</p>
    <div class="pt-4">
      <a href="/" class="text-xs text-[#ff2a85] hover:text-[#ff79c6] no-underline">
        &larr; [return to /]
      </a>
    </div>
  </div>
</BaseLayout>
