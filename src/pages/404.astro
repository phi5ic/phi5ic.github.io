---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Page Not Found">
  <div class="max-w-xl mx-auto py-24 text-center space-y-6">
    <div class="inline-block p-4 rounded-3xl bg-[#1a1b26] border border-white/10 text-4xl mb-2">
      ⚡
    </div>
    <h1 class="text-4xl sm:text-6xl font-extrabold text-white">404</h1>
    <h2 class="text-xl font-semibold text-[#7dcfff]">Page Not Found</h2>
    <p class="text-sm text-[#9aa5ce] leading-relaxed">
      The chunk or address you requested has not been replicated in this cluster yet.
    </p>
    <div class="pt-4">
      <a
        href="/"
        class="px-6 py-2.5 rounded-full bg-white text-[#0f1017] font-semibold text-sm hover:bg-[#c0caf5] transition-all shadow-lg"
      >
        Return to Home
      </a>
    </div>
  </div>
</BaseLayout>
