        <li>&bull; LinkedIn: <a href="https://www.linkedin.com/in/aravind-anilraj/" target="_blank" rel="noopener noreferrer" class="text-[#ff2a85] hover:text-[#ff79c6]">linkedin.com/in/aravind-anilraj &nearr;</a></li>
      </ul>
    </section>
