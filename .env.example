# ==============================================================================
# Environment Configuration Template for phi5ic.github.io
# ==============================================================================
# Copy this file to .env and configure the values appropriately.
#
# IMPORTANT SECURITY NOTES:
# - NEVER commit .env or any secret credentials into version control.
# - Keep all secret variables server-side. Do NOT use the `PUBLIC_` prefix
#   for any variable containing sensitive tokens or keys, as Vite/Astro will
#   bundle variables prefixed with `PUBLIC_` into client-side JavaScript.
# ==============================================================================

# ------------------------------------------------------------------------------
# GitHub OAuth App Credentials
# ------------------------------------------------------------------------------
# Register an OAuth application on GitHub:
# Settings -> Developer settings -> OAuth Apps -> New OAuth App
# - Homepage URL: http://localhost:4321 (or production domain)
# - Authorization callback URL: http://localhost:4321/api/auth/callback
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# ------------------------------------------------------------------------------
# Session Security
# ------------------------------------------------------------------------------
# Secret key used for signing / encrypting session cookies (AES-256-GCM).
# MUST be a cryptographically secure random string of at least 32 bytes (64 hex characters).
# Generate one using:
#   openssl rand -hex 32
# ------------------------------------------------------------------------------
SESSION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# Authorization & Access Control
# ------------------------------------------------------------------------------
# GitHub username permitted to access admin features and edit content.
# Only this username will be authenticated and allowed through admin routes.
# ------------------------------------------------------------------------------
ALLOWED_USER=phi5ic

# ------------------------------------------------------------------------------
# Server / Hosting Configuration
# ------------------------------------------------------------------------------
# Configuration for the standalone Node SSR adapter (@astrojs/node).
# PORT: Port on which the Node server listens.
# HOST: IP address to bind (0.0.0.0 to bind all interfaces, 127.0.0.1 for local only).
# ------------------------------------------------------------------------------
PORT=4321
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# GitHub Publishing Repository
# ------------------------------------------------------------------------------
# Target repository for reading/writing blog content via GitHub API.
# ------------------------------------------------------------------------------
GITHUB_REPO_OWNER=phi5ic
GITHUB_REPO_NAME=phi5ic.github.io
GITHUB_REPO_BRANCH=main
